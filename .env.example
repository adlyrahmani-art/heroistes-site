# Légende : [public|secret] · environnements Vercel · requis au build ou seulement à l'exécution

# [public] Production + Preview · requis au build (typegen, pages statiques)
NEXT_PUBLIC_SANITY_PROJECT_ID=
# [public] Production + Preview · requis au build · valeur : production
NEXT_PUBLIC_SANITY_DATASET=
# [secret] Production + Preview · requis au build (lecture des brouillons / Live Content API)
SANITY_API_READ_TOKEN=
# [secret] Production + Preview · exécution seulement (route /api/contact : copie et décompte des demandes)
SANITY_API_WRITE_TOKEN=
# [secret] Production + Preview · exécution seulement (envoi des e-mails)
RESEND_API_KEY=
# [public] Production + Preview · exécution seulement · expéditeur vérifié chez Resend, ex. Héroïstes <no-reply@heroistes.com>
CONTACT_FROM_EMAIL=
# [facultatif, public] Production + Preview · exécution seulement · destinataire de repli si Sanity est indisponible (défaut : contact@heroistes.com)
CONTACT_TO_EMAIL=
# [secret] Production + Preview · exécution seulement · sel du hachage des adresses IP (RGPD)
IP_HASH_SALT=
# [secret] Preview UNIQUEMENT, jamais en Production · exécution seulement · active les tests de bout en bout du formulaire
E2E_TOKEN=
